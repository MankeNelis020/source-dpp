# SOURCE environment template
# Copy to .env.local. Never commit secrets.

# Trusted runtime: local | preview | production
# Unset locally. Vercel sets VERCEL_ENV; SOURCE_ENV may also be set to match.
# SOURCE_ENV=

# local default is in-memory. Set postgres explicitly for a real database.
# SOURCE_PERSISTENCE=memory
# SOURCE_PERSISTENCE=postgres

# Public project URL (not a secret). Preview and production require this.
# Preview/dev:  https://hhuurdzzsinzwbkkokzz.supabase.co
# Production:   https://vezhdbzizniurehclxpg.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=

# Optional client-safe anon key. Auth is not this PR.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Restricted source_app role. Transaction pooler (port 6543) on hosted Supabase.
# SOURCE_APP_DATABASE_URL=

# Server-only. Migrator/DDL only. Direct connection (port 5432). Never source_app.
# SOURCE_MIGRATOR_DATABASE_URL=

# Local/CI isolated Postgres fallback for migrations/tests. Not used as both privilege levels in preview/production.
# DATABASE_URL=postgres://source:source@localhost:5432/source

# Server-only application secrets
# SOURCE_SESSION_SECRET=
# SOURCE_OPAQUE_REF_SECRET=
# SOURCE_STORAGE_SIGNING_SECRET=

# Server-only. Must never reach the browser. Not used for domain reads/writes.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional pg pool size for serverless (default 3)
# SOURCE_PG_POOL_MAX=3
