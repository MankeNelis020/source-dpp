# SOURCE environment template
# Copy to .env.local. Never commit secrets.

# Trusted runtime: local | preview | production
# Unset locally. Vercel sets VERCEL_ENV; SOURCE_ENV may also be set to match.
# SOURCE_ENV=

# local default is in-memory. Set postgres explicitly for a real database.
# SOURCE_PERSISTENCE=memory
# SOURCE_PERSISTENCE=postgres

# Public project URL (not a secret). Preview and production require this.
# Preview/dev:  https://hhuurdzzsinzwbkkokzz.supabase.co
# Production:   https://vezhdbzizniurehclxpg.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=

# Client-safe Auth anon key. Required in preview and production.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL used in Auth redirects and invite links (no trailing slash).
# Preview and production should match that environment's deployment.
# NEXT_PUBLIC_SOURCE_APP_URL=

# Identity provider: supabase | test
# Preview/production are always supabase (fail closed). Local defaults to test
# unless URL + anon key are set, or SOURCE_IDENTITY_PROVIDER=supabase.
# SOURCE_IDENTITY_PROVIDER=test

# Invitation expiry in days (server policy; default 7)
# SOURCE_INVITATION_TTL_DAYS=7

# Local only. Return invite URLs in API responses for testing. Never set on Vercel.
# SOURCE_EXPOSE_INVITE_LINKS=1

# Server-only. Restricted source_app role. Transaction pooler (port 6543) on hosted Supabase.
# SOURCE_APP_DATABASE_URL=

# Server-only. Migrator/DDL only. Direct connection (port 5432). Never source_app.
# SOURCE_MIGRATOR_DATABASE_URL=

# Object storage: memory | supabase
# Preview/production are always supabase (fail closed). Local defaults to memory.
# SOURCE_OBJECT_STORAGE=memory

# Private bucket names (not secrets)
# SOURCE_IMPORT_BUCKET=source-imports
# SOURCE_EVIDENCE_BUCKET=source-evidence

# Signed read lifetime in seconds (default 300)
# SOURCE_SIGNED_READ_TTL_SECONDS=300

# Temporary upload expiry in hours (default 24)
# SOURCE_TEMP_UPLOAD_TTL_HOURS=24

# Local/CI isolated Postgres fallback for migrations/tests. Not used as both privilege levels in preview/production.
# DATABASE_URL=postgres://source:source@localhost:5432/source

# Server-only application secrets
# SOURCE_SESSION_SECRET=
# SOURCE_OPAQUE_REF_SECRET=
# SOURCE_STORAGE_SIGNING_SECRET=

# Server-only. Must never reach the browser. Used only by SupabaseObjectStorage.
# Preview key must belong to the preview project; production key to the production project.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional pg pool size for serverless (default 3)
# SOURCE_PG_POOL_MAX=3
